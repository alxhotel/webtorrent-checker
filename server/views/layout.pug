html(lang='en')
	head
		title= rawTitle || (title && (title + ' - WebTorrent Checker')) || 'WebTorrent Checker'
		meta(name='description', content='Check the health of any torrent in Webtorrent and BitTorrent. Find the amount of seeders and peers in seconds.')

		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1')
		meta(name='color-scheme', content='light dark')

		//- Apply the saved theme before the page renders, so it doesn't flash
		script.
			try {
				var theme = localStorage.getItem('theme');
				if (theme === 'dark' || theme === 'light') document.documentElement.setAttribute('data-theme', theme);
			} catch (e) {}

		link(rel='stylesheet', href='/main.css', charset='utf-8')
		link(rel='icon', href='/favicon.ico', type='image/x-icon')

		block head
	body
		button#theme-toggle(type='button', aria-label='Toggle dark mode', title='Toggle dark mode')
			<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
			<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
		block body
		script(src='/bundle.js')

		script.
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-S1RNG05QZN');
		script(async, src='//www.googletagmanager.com/gtag/js?id=G-S1RNG05QZN')
